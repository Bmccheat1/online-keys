# ─── Copy this file to `.env` and fill in your real values ───
# ⚠️ NEVER commit your real .env to git

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/keys-selling?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# 🔒 Gateway config (set these to LOCK gateway from admin panel)
# Koi bhi admin change nahi kar sakta jab ye set ho
# QUICKGATEWAY_MERCHANT_TOKEN=your_merchant_token_here
# (optional) Default: https://api.quickgateway.in
# QUICKGATEWAY_API_URL=https://api.quickgateway.in

# 🔒 Webhook secret — used to verify QuickGateway webhook signatures (HMAC-SHA256)
# If not set, the webhook falls back to `webhook_secret` setting, then merchant token.
# WEBHOOK_SECRET=your_webhook_secret_here
